# Neon database (see https://neon.tech/docs)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Neon Auth (see the Authentication tab in the Neon console)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Sanity (see https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-15

# Sanity read token for the private dataset. Server only, never exposed to the browser.
SANITY_API_READ_TOKEN=

# Sanity Context MCP (see https://www.sanity.io/docs/sanity-context)
# Full MCP URL (optional; overrides the derived URL below).
SANITY_CONTEXT_MCP_URL=
# Slug of the Sanity Context document to apply (optional; base URL is used when unset).
SANITY_CONTEXT_SLUG=search

# Intelligent search (see https://ai.google.dev/gemini-api/docs/api-key)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: which Gemini model to use for search (default gemini-2.5-pro).
SEARCH_MODEL=
